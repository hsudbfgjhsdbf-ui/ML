# Copy to .env and fill as needed - NEVER commit real keys
# OCR
OCR_ENGINE=fallback
TESSERACT_CMD=/usr/bin/tesseract

# Vision-Language Model (optional)
VLM_PROVIDER=none
VLM_API_KEY=
VLM_API_URL=
VLM_MODEL=

# LLM for RAG / Agentic (optional)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=gpt-4o-mini

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store
VECTOR_STORE=local_json

# Paths
DATA_RAW_PATH=data/raw/Health_Insurance_Fraud_Claims.xlsx
DATA_PROCESSED_PATH=data/processed/claims_processed.csv
MODEL_ARTIFACTS_DIR=data/processed/artifacts

# Flags
ENABLE_EXTERNAL_API_CALLS=false
ANONYMIZE_PII=true
